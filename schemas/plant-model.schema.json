{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/plant-model.schema.json",
  "title": "PowderTwin Plant Model",
  "type": "object",
  "required": ["schemaVersion", "plant", "line", "equipment", "routes", "recipes"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "plant": {
      "type": "object",
      "required": ["id", "name", "mode"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "timezone": { "type": "string" },
        "mode": { "enum": ["offline", "hybrid", "online"] }
      }
    },
    "line": {
      "type": "object",
      "required": ["id", "name", "nominalShiftHours"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nominalShiftHours": { "type": "number", "minimum": 1 },
        "targetOee": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "equipment": { "type": "array", "items": { "$ref": "#/$defs/equipment" } },
    "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "recipes": { "type": "array", "items": { "$ref": "#/$defs/recipe" } },
    "assumptions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "equipment": {
      "type": "object",
      "required": ["id", "name", "area", "capacityKgH", "powerKw", "criticality"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "area": { "type": "string" },
        "capacityKgH": { "type": "number", "minimum": 0 },
        "cycleMin": { "type": "number", "minimum": 0 },
        "powerKw": { "type": "number", "minimum": 0 },
        "criticality": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "route": {
      "type": "object",
      "required": ["id", "name", "steps"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "recipe": {
      "type": "object",
      "required": ["id", "name", "nominalKgH", "complexity", "qualityRisk"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nominalKgH": { "type": "number", "minimum": 0 },
        "complexity": { "type": "number", "minimum": 0.1 },
        "qualityRisk": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
